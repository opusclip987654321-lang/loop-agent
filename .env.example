# Copier en .env (sur le serveur : /opt/loop-agent/.env) et remplir.
# Ce fichier .env ne va JAMAIS sur GitHub.

# Empreinte du mot de passe (jamais le mot de passe lui-même).
# Générée par :  npm run hash-password   (ou, sur le serveur :
#   docker compose run --rm loop-agent node scripts/hash-password.js)
LOOP_AGENT_PASSWORD_HASH=''

# Durée d'une session ouverte, en jours.
SESSION_DAYS=30

# Adresse du site, ajoutée en bas de chaque récap Telegram.
SITE_URL='https://loopagent.actualitevideo.fr'

# Récap Telegram groupé (un message par tour d'agent). Laisser vide = pas d'envoi.
# Jeton du bot dédié (donné par @BotFather) et identifiant de la conversation.
TELEGRAM_BOT_TOKEN=''
TELEGRAM_CHAT_ID=''
# Minutes sans écriture d'un agent avant d'envoyer son récap.
TELEGRAM_QUIET_MINUTES=3

# Sauvegardes nocturnes de la base (dans le volume, dossier backups).
BACKUP_KEEP=14
BACKUP_HOUR=3
