# Copier en .env (sur le serveur : /opt/loop-agent/.env) et remplir.
# Ce fichier .env ne va JAMAIS sur GitHub.

# Empreinte du mot de passe (jamais le mot de passe lui-même).
# Générée par :  npm run hash-password   (ou, sur le serveur :
#   docker compose run --rm loop-agent node scripts/hash-password.js)
LOOP_AGENT_PASSWORD_HASH=''

# Durée d'une session ouverte, en jours.
SESSION_DAYS=30
